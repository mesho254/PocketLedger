{
  "info": {
    "name": "PocketLedger Multi-Module API Collection",
    "description": "Postman collection for PocketLedger multi-module backend (auth, transaction, budget, savings, analytics)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Auth Module",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alex@pocketledger.com\",\n  \"password\": \"password123\",\n  \"fullName\": \"Alex Morgan\",\n  \"currency\": \"USD\"\n}"
            }
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alex@pocketledger.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Get Current User Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "2. Transaction Module",
      "item": [
        {
          "name": "Create Transaction",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/transactions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 85.50,\n  \"type\": \"EXPENSE\",\n  \"category\": \"FOOD\",\n  \"transactionDate\": \"2026-10-28\",\n  \"description\": \"Weekly groceries\"\n}"
            }
          }
        },
        {
          "name": "List Transactions",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/transactions?page=0&size=20"
          }
        }
      ]
    },
    {
      "name": "3. Budget Module",
      "item": [
        {
          "name": "Set Monthly Category Budget",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/budgets",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"FOOD\",\n  \"monthlyLimit\": 450.00,\n  \"month\": 10,\n  \"year\": 2026\n}"
            }
          }
        },
        {
          "name": "Get Budget Progress",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/budgets/progress?year=2026&month=10"
          }
        }
      ]
    },
    {
      "name": "4. Savings Module",
      "item": [
        {
          "name": "Create Savings Goal",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/savings-goals",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Emergency Fund\",\n  \"targetAmount\": 5000.00,\n  \"targetDate\": \"2027-12-31\"\n}"
            }
          }
        },
        {
          "name": "List Savings Goals",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/savings-goals"
          }
        }
      ]
    },
    {
      "name": "5. Analytics Module",
      "item": [
        {
          "name": "Get Monthly Summary",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/analytics/monthly-summary?year=2026&month=10"
          }
        }
      ]
    }
  ]
}

